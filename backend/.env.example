# Copy to backend/.env (never committed) and fill in only what you use.
# Environment variables always win over this file. See docs/day2-design.md section 8.4.

# true (default): rule analyst + templates, no network, no secret
USE_MOCK_LLM=true
# ollama | openai | foundry (used only when USE_MOCK_LLM=false)
#   ollama : local model, no account (install https://ollama.com, then `ollama pull qwen2.5:3b`)
#   openai : any OpenAI-compatible endpoint (LLM_BASE_URL + LLM_MODEL, optional LLM_API_KEY)
#   foundry: Microsoft Foundry (the target for the submission)
# GitHub Models was retired on 2026-07-30 and is not a provider any more.
LLM_PROVIDER=

# ollama defaults: LLM_BASE_URL=http://127.0.0.1:11434/v1, LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Microsoft Foundry (Entra ID by default: `az login` locally, managed identity on Azure)
FOUNDRY_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=
# Dev only, instead of Entra ID
FOUNDRY_API_KEY=

# Seconds per LLM call / per claim. Defaults: 4 / 8, and 90 / 200 for ollama (CPU).
LLM_TIMEOUT_S=
CLAIM_BUDGET_S=

# Demo / tests: e.g. explainer:hallucinate:2 or analyst:timeout:1,explainer:unsafe
MOCK_LLM_FAULTS=
MOCK_LLM_LATENCY_MS=0

# Comma-separated origins allowed to call the API (Day 4 dashboard)
CORS_ORIGINS=http://localhost:3000

# Day 5: the voice (docs/day5-design.md section 3.7)
# off | browser | mock | azure. mock (default): deterministic WAV, no network, no secret;
# browser: the fan's browser reads the server's spoken script; azure: Azure AI Speech.
TTS_PROVIDER=mock
# Languages read aloud, comma-separated (only vi has a spoken pack today)
TTS_LANGUAGES=vi
# Azure AI Speech: SPEECH_ENDPOINT (custom domain) + SPEECH_RESOURCE_ID for Entra ID /
# managed identity (role Cognitive Services Speech User); SPEECH_KEY + SPEECH_REGION in dev only
SPEECH_ENDPOINT=
SPEECH_RESOURCE_ID=
SPEECH_REGION=
SPEECH_KEY=
# Requests per minute (default 18 for azure: under the F0 limit), parallel calls, seconds
TTS_MAX_RPM=
TTS_MAX_CONCURRENCY=
TTS_TIMEOUT_S=
TTS_RECAP_TIMEOUT_S=
# Characters per day before the voice falls back to the browser (default 200000)
TTS_DAILY_CHAR_BUDGET=
# No voice above this replay speed (default 20x)
TTS_MAX_SPEED=
# Clip cache (default: the system temp folder) and the durable store for recaps
AUDIO_CACHE_DIR=
AUDIO_STORE=local
AUDIO_STORE_DIR=
# AUDIO_STORE=blob: the account URL (managed identity), or a connection string for Azurite
AUDIO_BLOB_ACCOUNT_URL=
AUDIO_BLOB_CONTAINER=audio
AUDIO_BLOB_CONNECTION_STRING=
# Demo / tests: kind[:count], kind in error, timeout, throttle, bad_audio, auth (e.g. timeout:2,error)
MOCK_TTS_FAULTS=
MOCK_TTS_LATENCY_MS=0

# Speech-to-text for spoken claims (P2): off | mock | azure
STT_PROVIDER=off
STT_MAX_SECONDS=

# --- Day 6: MCP on /mcp (docs/mcp.md) ---------------------------------------------------
# false: no /mcp (the Day 5 app)
MCP_ENABLED=true
# Host names served on /mcp, comma separated (others get 421). On Azure add the app's host.
MCP_ALLOWED_HOSTS=127.0.0.1,localhost
# Tool calls per minute and client (verify_claim counts 3)
MCP_RATE_PER_MINUTE=60
# true behind a trusted proxy (Azure Container Apps ingress): the client is the last
# X-Forwarded-For hop. Keep false when the app is reached directly.
TRUST_PROXY=false
