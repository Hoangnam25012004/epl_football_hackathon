# Copy to backend/.env (never committed) and fill in only what you use.
# Environment variables always win over this file. See docs/day2-design.md section 8.4.

# true (default): rule analyst + templates, no network, no secret
USE_MOCK_LLM=true
# github | foundry (used only when USE_MOCK_LLM=false)
LLM_PROVIDER=

# GitHub Models (interim real LLM)
GITHUB_TOKEN=
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# Microsoft Foundry (Entra ID by default: `az login` locally, managed identity on Azure)
FOUNDRY_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=
# Dev only, instead of Entra ID
FOUNDRY_API_KEY=

# Seconds per LLM call / per claim
LLM_TIMEOUT_S=4
CLAIM_BUDGET_S=8

# Demo / tests: e.g. explainer:hallucinate:2 or analyst:timeout:1,explainer:unsafe
MOCK_LLM_FAULTS=
MOCK_LLM_LATENCY_MS=0

# Comma-separated origins allowed to call the API (Day 4 dashboard)
CORS_ORIGINS=http://localhost:3000
