# Defaults of the Hugging Face Space (docs/day7-design.md section 2.2). No secret here.
# start.sh exports a line only when the variable is not set already, so a variable set in the
# Space's settings wins. KEEPALIVE_URL, CORS_ORIGINS and MCP_ALLOWED_HOSTS come from SPACE_HOST,
# and LLM_MODEL from the image (the model that was pulled into it).

# the model on the CPU of the container, for claims only: the studio and the recaps write from
# their templates (a CPU model misses their 2.5-3 s budgets)
USE_MOCK_LLM=false
LLM_PROVIDER=ollama
LLM_LIVE_SCOPE=claims
# until the claim is progressive (C4): a claim waits 45 s at most, then answers from the rules
# (spike S1 on 2 CPUs: 5 tokens/s, a model pass p50 114 s; docs/day7-design.md section 7)
LLM_TIMEOUT_S=40
CLAIM_BUDGET_S=45

# the voice: the browser reads the server's script until the Piper provider (C8) is in
TTS_PROVIDER=browser
STT_PROVIDER=off

# behind the proxy of Hugging Face: X-Forwarded-For names the client (sessions and MCP limits)
TRUST_PROXY=true

# layer 1 of the keepalive: the app pings its public URL every 20 minutes
KEEPALIVE_INTERVAL_S=1200
