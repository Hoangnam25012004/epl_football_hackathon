{
  "$defs": {
    "Fact": {
      "additionalProperties": false,
      "description": "A number that may be said out loud. Shared by the claim verifier, moments and Day 3.",
      "properties": {
        "derived": {
          "default": false,
          "title": "Derived",
          "type": "boolean"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label_en": {
          "title": "Label En",
          "type": "string"
        },
        "label_vi": {
          "title": "Label Vi",
          "type": "string"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "player": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]+-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player"
        },
        "team": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team"
        },
        "unit": {
          "enum": [
            "count",
            "percent",
            "xg",
            "meters",
            "kmh",
            "minutes",
            "ratio",
            "index",
            "rating"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "key",
        "label_vi",
        "label_en",
        "value",
        "unit",
        "display",
        "evidence_event_ids"
      ],
      "title": "Fact",
      "type": "object"
    },
    "TalkingLine": {
      "additionalProperties": false,
      "properties": {
        "angle": {
          "enum": [
            "headline",
            "stat",
            "story"
          ],
          "title": "Angle",
          "type": "string"
        },
        "fact_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fact Keys",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "angle"
      ],
      "title": "TalkingLine",
      "type": "object"
    },
    "TraceSpan": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "number"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "kind": {
          "enum": [
            "agent",
            "tool",
            "llm",
            "guardrail",
            "fallback"
          ],
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "output": {
          "additionalProperties": true,
          "title": "Output",
          "type": "object"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        },
        "span_id": {
          "title": "Span Id",
          "type": "string"
        },
        "start_ms": {
          "title": "Start Ms",
          "type": "number"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "retry",
            "fallback",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "span_id",
        "parent_id",
        "agent",
        "kind",
        "name",
        "input",
        "output",
        "status",
        "attempt",
        "start_ms",
        "duration_ms",
        "model",
        "error"
      ],
      "title": "TraceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of_seq": {
      "title": "As Of Seq",
      "type": "integer"
    },
    "clock_ms": {
      "title": "Clock Ms",
      "type": "integer"
    },
    "degraded": {
      "default": [],
      "items": {
        "enum": [
          "analyst_fallback",
          "analyst_disagreement",
          "explainer_fallback",
          "circuit_open",
          "orchestrator_fallback",
          "writer_fallback",
          "llm_skipped"
        ],
        "type": "string"
      },
      "title": "Degraded",
      "type": "array"
    },
    "display_minute": {
      "title": "Display Minute",
      "type": "string"
    },
    "en": {
      "items": {
        "$ref": "#/$defs/TalkingLine"
      },
      "maxItems": 3,
      "minItems": 2,
      "title": "En",
      "type": "array"
    },
    "evidence_event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Event Ids",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "importance": {
      "enum": [
        2,
        3
      ],
      "title": "Importance",
      "type": "integer"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "period": {
      "title": "Period",
      "type": "integer"
    },
    "source_en": {
      "enum": [
        "llm",
        "template"
      ],
      "title": "Source En",
      "type": "string"
    },
    "source_vi": {
      "enum": [
        "llm",
        "template"
      ],
      "title": "Source Vi",
      "type": "string"
    },
    "status": {
      "default": "new",
      "enum": [
        "new",
        "approved",
        "dismissed",
        "pinned"
      ],
      "title": "Status",
      "type": "string"
    },
    "trace": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/TraceSpan"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace"
    },
    "trigger_id": {
      "title": "Trigger Id",
      "type": "string"
    },
    "trigger_kind": {
      "title": "Trigger Kind",
      "type": "string"
    },
    "vi": {
      "items": {
        "$ref": "#/$defs/TalkingLine"
      },
      "maxItems": 3,
      "minItems": 2,
      "title": "Vi",
      "type": "array"
    }
  },
  "required": [
    "id",
    "match_id",
    "trigger_id",
    "trigger_kind",
    "importance",
    "period",
    "clock_ms",
    "display_minute",
    "as_of_seq",
    "en",
    "vi",
    "source_en",
    "source_vi",
    "model",
    "facts",
    "evidence_event_ids"
  ],
  "title": "TalkingPoint",
  "type": "object"
}
