{
  "$defs": {
    "AudioRef": {
      "additionalProperties": false,
      "description": "A clip of the server, named by its content (cacheable for ever).",
      "properties": {
        "clip_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Clip Id",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "exact": {
          "title": "Exact",
          "type": "boolean"
        },
        "media_type": {
          "enum": [
            "audio/mpeg",
            "audio/wav"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "clip_id",
        "url",
        "media_type",
        "duration_ms",
        "exact"
      ],
      "title": "AudioRef",
      "type": "object"
    },
    "FactView": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "title": "Display",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "display"
      ],
      "title": "FactView",
      "type": "object"
    },
    "RuleView": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "enum": [
            "full",
            "short"
          ],
          "title": "Depth",
          "type": "string"
        },
        "rule": {
          "enum": [
            "offside",
            "var",
            "penalty",
            "second_yellow",
            "red_card",
            "yellow_card",
            "corner",
            "substitution",
            "added_time",
            "xg",
            "possession",
            "momentum",
            "ppda",
            "chaos",
            "tempo"
          ],
          "title": "Rule",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "title",
        "text",
        "depth"
      ],
      "title": "RuleView",
      "type": "object"
    },
    "SpeechCue": {
      "additionalProperties": false,
      "description": "What to read aloud for one item and one voice; `audio` or `note`, never both.",
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gender": {
          "enum": [
            "female",
            "male"
          ],
          "title": "Gender",
          "type": "string"
        },
        "lang": {
          "enum": [
            "vi-VN",
            "en-GB"
          ],
          "title": "Lang",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "enum": [
                "server_off",
                "speed",
                "circuit_open",
                "throttled",
                "budget",
                "guard"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "preset": {
          "enum": [
            "calm",
            "lively",
            "excited",
            "peak",
            "burst",
            "tension",
            "explainer",
            "recap",
            "greeting"
          ],
          "title": "Preset",
          "type": "string"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/SpeechSegment"
          },
          "maxItems": 24,
          "title": "Segments",
          "type": "array"
        },
        "voice": {
          "title": "Voice",
          "type": "string"
        }
      },
      "required": [
        "lang",
        "voice",
        "gender",
        "preset",
        "segments"
      ],
      "title": "SpeechCue",
      "type": "object"
    },
    "SpeechSegment": {
      "additionalProperties": false,
      "description": "One part of a spoken script: the words read (numbers written as words) and their prosody,\nshared by the SSML of the server and the browser's voice (docs/day5-design.md V4).",
      "properties": {
        "pause_before_ms": {
          "default": 0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Pause Before Ms",
          "type": "integer"
        },
        "pitch": {
          "maximum": 1.5,
          "minimum": 0.5,
          "title": "Pitch",
          "type": "number"
        },
        "preset": {
          "enum": [
            "calm",
            "lively",
            "excited",
            "peak",
            "burst",
            "tension",
            "explainer",
            "recap",
            "greeting"
          ],
          "title": "Preset",
          "type": "string"
        },
        "rate": {
          "maximum": 2.0,
          "minimum": 0.5,
          "title": "Rate",
          "type": "number"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "volume": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Volume",
          "type": "number"
        }
      },
      "required": [
        "text",
        "preset",
        "rate",
        "pitch",
        "volume"
      ],
      "title": "SpeechSegment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Payload of the WebSocket message `commentary`: one item for one profile.",
  "properties": {
    "clock_ms": {
      "title": "Clock Ms",
      "type": "integer"
    },
    "display_minute": {
      "title": "Display Minute",
      "type": "string"
    },
    "emphasis": {
      "default": "neutral",
      "enum": [
        "own_team",
        "opponent",
        "neutral",
        "focus_player"
      ],
      "title": "Emphasis",
      "type": "string"
    },
    "excitement": {
      "default": 0,
      "title": "Excitement",
      "type": "integer"
    },
    "explanation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuleView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "facts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FactView"
      },
      "title": "Facts",
      "type": "array"
    },
    "framing": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Framing"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "importance": {
      "enum": [
        1,
        2,
        3
      ],
      "title": "Importance",
      "type": "integer"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "language": {
      "enum": [
        "vi",
        "en"
      ],
      "title": "Language",
      "type": "string"
    },
    "mode": {
      "enum": [
        "analyst",
        "casual"
      ],
      "title": "Mode",
      "type": "string"
    },
    "period": {
      "title": "Period",
      "type": "integer"
    },
    "player_tracker": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/FactView"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Player Tracker"
    },
    "relevance": {
      "default": "normal",
      "enum": [
        "high",
        "normal",
        "low"
      ],
      "title": "Relevance",
      "type": "string"
    },
    "source": {
      "enum": [
        "llm",
        "template"
      ],
      "title": "Source",
      "type": "string"
    },
    "speak": {
      "default": false,
      "title": "Speak",
      "type": "boolean"
    },
    "speech": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpeechCue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "trigger_id": {
      "title": "Trigger Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "trigger_id",
    "kind",
    "period",
    "clock_ms",
    "display_minute",
    "importance",
    "language",
    "mode",
    "text",
    "source"
  ],
  "title": "CommentaryView",
  "type": "object"
}
