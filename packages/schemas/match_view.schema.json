  "properties": {
    "info": {
      "$ref": "#/$defs/MatchInfo"
    },
    "snapshot": {
      "$ref": "#/$defs/MatchSnapshot"
    }
  },
  "required": [
    "info",
    "snapshot"
  ],
  "title": "MatchView",
  "type": "object"
}
