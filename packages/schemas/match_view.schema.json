        "match_id",
        "phase",
        "period",
        "clock_display",
        "as_of_seq",
        "as_of_ms",
        "score",
        "ball_in_play",
        "holder_team",
        "holder_since_ms",
        "possession_ms",
        "ball_in_play_ms",
        "possession_pct",
        "on_pitch",
        "booked",
        "sent_off",
        "last_event_id"
