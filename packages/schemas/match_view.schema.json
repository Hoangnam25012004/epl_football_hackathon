      "properties": {
        "away": {
          "$ref": "#/$defs/TeamBrief"
        },
        "claims": {
          "title": "Claims",
          "type": "integer"
        },
        "disclaimer": {
          "title": "Disclaimer",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "events_applied": {
          "title": "Events Applied",
          "type": "integer"
        },
        "events_total": {
          "title": "Events Total",
          "type": "integer"
        },
        "from_minute": {
          "title": "From Minute",
          "type": "number"
        },
        "home": {
          "$ref": "#/$defs/TeamBrief"
        },
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "moments": {
          "title": "Moments",
          "type": "integer"
        },
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "speed": {
          "title": "Speed",
          "type": "number"
        },
        "status": {
          "enum": [
            "created",
            "running",
            "paused",
            "finished",
            "stopped",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "studio": {
          "anyOf": [
            {
              "$ref": "#/$defs/StudioStats"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "match_id",
        "scenario",
        "seed",
        "status",
        "error",
        "speed",
        "from_minute",
        "events_total",
        "events_applied",
        "home",
        "away",
        "moments",
        "claims",
        "synthetic",
        "disclaimer"
      ],
      "title": "MatchInfo",
      "type": "object"
    },
    "MatchSnapshot": {
