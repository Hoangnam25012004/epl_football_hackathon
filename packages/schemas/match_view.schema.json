        "degraded": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Degraded",
          "type": "object"
        },
        "dropped": {
          "title": "Dropped",
          "type": "integer"
        },
        "errors": {
          "title": "Errors",
          "type": "integer"
