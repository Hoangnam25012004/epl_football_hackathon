          "type": "object"
        },
        "score": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Score",
          "type": "object"
        },
        "sent_off": {
          "items": {
            "type": "string"
          },
          "title": "Sent Off",
          "type": "array"
        }
