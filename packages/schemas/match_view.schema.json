        },
        "lower_thirds": {
          "title": "Lower Thirds",
          "type": "integer"
        },
        "processed": {
          "title": "Processed",
          "type": "integer"
        },
        "queued": {
          "title": "Queued",
          "type": "integer"
        },
        "recaps": {
          "items": {
            "type": "string"
          },
          "title": "Recaps",
          "type": "array"
        },
        "talking_points": {
          "title": "Talking Points",
          "type": "integer"
        }
